<main class="buyer-page">
  <div class="container buyer-container">
    <section class="buyer-hero">
      <div>
        <span class="eyebrow">Book Marketplace</span>
        <h1 class="page-title">Dobrodošao, <%= title %></h1>
        <p>Pronađi sljedeću knjigu za svoju kolekciju.</p>
      </div>
      <a href="/buyer/logout" class="logout-button">Odjava</a>
    </section>

  <section class="online-panel" aria-label="Online korisnici">
    <div class="online-heading">
      <span class="online-dot"></span>
      <h2 class="online-title">Online korisnici</h2>
    </div>
  <ul class="online-list">
    <% if (online.length===0) { %>
      <li class="empty-online">
        Trenutno nema online korisnika.
      </li>
      <% } else { %>
        <% online.forEach(id=> { %>
          <li>
            <a href="/chat/<%= id %>" class="chat-btn">
              💬 Chat sa korisnikom #<%= id %>
            </a>
          </li>
          <% }) %>
            <% } %>
  </ul>
  </section>


  <div class="catalog-toolbar mb-5">


    <div>
      <span class="eyebrow">Istraži ponudu</span>
      <h2>Pronađi knjigu</h2>
    </div>
    <form id="filterForm" class="filter-panel">

      <!-- ŽANR -->
      <select id="filterGenre" class="form-select form-select-sm" style="width:160px">
        <option value="">Žanr</option>

        <% allgenres.forEach(g=> { %>
          <option value="<%= g.id %>">
            <%= g.name %>
          </option>
          <% }) %>
      </select>


      <!-- JEZIK -->
      <select id="filterLanguage" class="form-select form-select-sm" style="width:140px">
        <option value="">Jezik</option>

        <% alllanguages.forEach(l=> { %>
          <option value="<%= l.id %>">
            <%= l.name %>
          </option>
          <% }) %>
      </select>


      <!-- CIJENA -->
      <input id="priceFrom" type="number" class="form-control form-control-sm" placeholder="Cijena od"
        style="width:110px">
      <input id="priceTo" type="number" class="form-control form-control-sm" placeholder="Cijena do"
        style="width:110px">

      <!-- TEXT SEARCH -->
      <input id="searchText" type="text" class="form-control form-control-sm" placeholder="Naziv / autor">

      <!-- BUTTON -->
      <button type="submit" class="btn btn-sm btn-primary">
        Filter
      </button>
      <a href="/buyer/cart" class="cart-button">
        Korpa <span aria-hidden="true">→</span>
      </a>

    </form>


  </div>




  <!-- ================= NAJPOPULARNIJE ================= -->
  <section class="catalog-section mb-5">
    <div class="section-heading">
      <span class="section-number">01</span>
      <div><span class="eyebrow">Najviše pažnje</span><h2>Najpopularnije knjige</h2></div>
    </div>

    <div class="row g-4">
      <% AllBooks.forEach(book=> { %>
        <div class="col-md-6 col-lg-4">
          <div class="card h-100 shadow-sm book-card" id="book_<%= book.id %>"
            onclick='openBookModal(<%- JSON.stringify(book) %>)'>

            <div class="card-body">
              <h5 class="card-title">
                <%= book.title %>
              </h5>
              <p class="text-muted mb-1">
                <%= book.author %>
              </p>

              <p class="fw-bold text-success">
                <%= book.price==0 ? 'Razmjena' : book.price + ' KM' %>
              </p>


              <p>
                <span class="badge bg-info">
                  <%= book.genre.name || 'Žanr' %>
                </span>
                <span class="badge bg-success">
                  <%= book.status %>
                </span>
                <strong>Jezik:</strong>
                <%= book.language.name || '—' %>

              </p>
            </div>

          </div>
        </div>
        <% }) %>
    </div>
  </section>

  <!-- ================= RANDOM ================= -->
  <section class="catalog-section mb-5">
    <div class="section-heading">
      <span class="section-number">02</span>
      <div><span class="eyebrow">Za malo iznenađenja</span><h2>Slučajno odabrane knjige</h2></div>
    </div>

    <div class="row g-4">
      <% randomBooks.forEach(book=> { %>
        <div class="col-md-6 col-lg-4">
          <div class="card h-100 shadow-sm book-card" id="book_<%= book.id %>"
            onclick='openBookModal(<%- JSON.stringify(book) %>)'>

            <div class="card-body">
              <h5 class="card-title">
                <%= book.title %>
              </h5>
              <p class="text-muted mb-1">
                <%= book.author %>
              </p>

              <p>
                <span class="badge bg-info">
                  <%= book.genre || 'Žanr' %>
                </span>
                <span class="badge bg-success">
                  <%= book.status %>
                </span>
                <strong>Jezik:</strong>
                <%= book.language || '—' %>

              </p>
            </div>

          </div>
        </div>
        <% }) %>
    </div>
  </section>

  <!-- ================= PREPORUČENE ================= -->
  <section class="catalog-section mb-5">
    <div class="section-heading">
      <span class="section-number">03</span>
      <div><span class="eyebrow">Odabrano za tebe</span><h2>Preporučene za vas</h2></div>
    </div>

    <div class="row g-4">
      <% recommendedBooks.forEach(book=> { %>
        <div class="col-md-6 col-lg-4">
          <div class="card h-100 shadow-sm book-card" id="book_<%= book.id %>"
            onclick='openBookModal(<%- JSON.stringify(book) %>)'>


            <div class="card-body">
              <h5 class="card-title">
                <%= book.title %>
              </h5>
              <p class="text-muted mb-1">
                <%= book.author %>
              </p>

              <p>
                <span class="badge bg-info">
                  <%= book.genre || 'Žanr' %>
                </span>
                <span class="badge bg-success">
                  <%= book.status %>
                </span>
                <strong>Jezik:</strong>
                <%= book.language || '—' %>

              </p>
            </div>

          </div>
        </div>
        <% }) %>
    </div>
  </section>

</div>
</main>

<!-- ================= MODAL ================= -->
<div class="modal fade" id="bookModal" tabindex="-1">
  <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content rounded-4 shadow">

      <!-- HEADER -->
      <div class="modal-header">
        <div>
          <h4 class="modal-title fw-bold" id="modalTitle"></h4>
          <p class="text-muted mb-0" id="modalAuthor"></p>
        </div>
        <button class="btn-close" data-bs-dismiss="modal"></button>
      </div>

      <!-- BODY -->
      <div class="modal-body">
        <div class="row g-3">
          <div class="col-md-6">
            <p><strong>Cijena:</strong>
              <span id="modalPrice" class="fw-bold text-success"></span>
            </p>
            <p><strong>Status:</strong>
              <span id="modalStatus"></span>
            </p>
            <p><strong>Žanr:</strong>
              <span id="modalGenre"></span>
            </p>
            <p><strong>Jezik:</strong>
              <span id="modalLanguage"></span>
            </p>
          </div>

          <div class="col-md-6">
            <p><strong>Godina izdanja:</strong>
              <span id="modalYear"></span>
            </p>

            <p><strong>Stanje:</strong>
              <span id="modalCondition"></span> / 5
            </p>

            <p><strong>Razmjena:</strong>
              <span id="modalExchange"></span>
            </p>
          </div>

        </div>

        <hr>

        <h6 class="fw-bold">Opis knjige</h6>
        <p id="modalDescription" class="text-muted"></p>

      </div>

      <!-- FOOTER -->
      <div class="modal-footer d-flex justify-content-between">
        <button class="btn btn-outline-secondary" data-bs-dismiss="modal">
          Zatvori
        </button>

        <button id="buyButton" class="btn btn-success">
          Kupi knjigu</button>
      </div>

    </div>
  </div>
</div>


<!--Bootstrap kood za obavijest da je kupljeno -->
<div id="buyAlert" class="toast position-fixed bottom-0 end-0 m-3" role="alert" data-bs-delay="1500">
  <div class="toast-body bg-success text-white">
    Kupljena knjiga
  </div>
</div>


<!-- ================= JS ================= -->